#!/bin/bash

set -o pipefail

#
# HELP

usage() {
  echo "Usage: stest-all [OPTION...] [TOP-DIRECTORY]"
  echo "run every .stest file in the current or given directory tree, in parallel"
  echo
  echo Options
  echo "  --list          : list the selected tests instead of running them"
  echo "  -x, --executable: select only executable .stest files"
  echo "  -u, --unrestricted: include hidden/ignored (fd), vendor, and node_modules files"
  echo "  --list-tags     : list every tag of the selected files with its file count"
  echo "  --list-required : list every @require-tag tag of the selected files with its file count"
  echo "                     both include opt-in files and accept the other selection options"
  echo "  --all           : also run files with @require-tag, as if their tags were requested"
  echo "  --tag=prod      : select files tagged prod; repeat, or separate tags with comma/space"
  echo "  --tag='prod -long': select prod files, excluding those also tagged long"
  echo "                     files with @require-tag run only when one of their tags is requested"
  echo "                     a positive-only query that matches nothing exits non-zero"
  echo "  --recent        : select tests changed in the last day"
  echo "  --recent=2day   : select tests changed in the last 2 days"
  echo "  --new           : select the newest test after other filters"
  echo "  --new=4         : select the 4 newest tests after other filters"
  echo "  --timeout=15    : curl connect/transfer timeout for each web request, in seconds"
  echo "  -j 40, --jobs=40: run at most 40 files at once (also -j40); STEST_JOBS=40 sets the default"
  echo "                     for web suites, keep it near the target's PHP-FPM worker count"
  echo "  -r, --read-only : never rewrite a .stest file; a missing result fails"
  echo "  --retry=2       : after the whole run, re-run the failed files, up to 2 more rounds"
  echo "                     (warm caches); with -q only the last attempt's output is shown"
  echo "  --once[=1day]   : skip files unchanged since they passed within the period; --once=reset|ignore"
  echo "  --rerun-failed  : run only the files that failed in earlier runs of this directory"
  echo "  --shard=2/4     : run the 2nd of 4 equal slices of the selected files (CI split)"
  echo "  --slowest[=10]  : after the run, list the 10 slowest files by their own stest process time"
  echo "  --json          : print a JSON report on STDOUT (test output goes to STDERR)"
  echo "  --json=FILE     : also write the JSON report to FILE"
#  echo " -v  : verbose - show test names"   << DEFAULT
  echo "  -q              : quiet - show errors only; test selection is unchanged"
  echo "  Without -j, concurrency follows the file-descriptor limit and is capped at 100 GNU Parallel jobs"
  echo "  -j may go above 100, never above the file-descriptor limit"
  echo "  Every output line is prefixed with the .stest path that produced it"
  echo "  A summary follows the run; with -q it is printed only when something failed, on STDERR"
  echo "  State (failed files, once) is kept in \${XDG_CONFIG_HOME:-~/.config}/stest/"
}

recent_minutes() {
  local v="${1:-1day}"
  case "$v" in
    *day) echo $(( ${v%day} * 1440 )) ;;
    *days) echo $(( ${v%days} * 1440 )) ;;
    *) echo $(( v * 1440 )) ;;
  esac
}

recent_duration() {
  local v="${1:-1day}"
  case "$v" in
    *day|*days) printf '%s\n' "$v" ;;
    *) printf '%sday\n' "$v" ;;
  esac
}

parallel_jobs() {
  local requested=$1
  local fd_limit jobs
  # stest is IO-bound, not CPU-bound: cap concurrency at a fixed ceiling rather
  # than scaling with the fd limit. A large ulimit -Sn (e.g. 524288) would
  # otherwise launch every test at once and thrash the machine.
  local max=100
  # -j / STEST_JOBS replaces the ceiling: a web suite is bounded by the target's
  # PHP-FPM workers, which only the caller knows. More concurrent requests than
  # workers queue up, and a heavy page then misses the curl timeout (code 999).
  [[ -n $requested ]] && max=$requested

  fd_limit=$(ulimit -Sn) || return 1
  if [[ $fd_limit == unlimited ]]; then
    echo "$max"
    return
  fi

  # Grouped GNU Parallel jobs use about four descriptors each. Keep room for
  # Parallel's own descriptors and inherited shell descriptors.
  jobs=$(( (fd_limit - 32) / 4 ))
  (( jobs < 1 )) && jobs=1
  (( jobs > max )) && jobs=$max
  echo "$jobs"
}

discover_with_find() {
  local find_args=(\( -type f -o -type l \) -name "*.stest")
  if [[ $executable_only == 1 ]]; then
    find_args+=(-executable)
  fi
  if [[ -n "$recent" ]]; then
    find_args+=(-mmin "-$(recent_minutes "$recent")")
  fi

  if [[ $unrestricted == 1 ]]; then
    find . "${find_args[@]}"
  else
    find . \( -type d \( -name vendor -o -name node_modules -o \( -name '.*' ! -path . \) \) -prune \) \
      -o \( "${find_args[@]}" ! -name '.*' -print \)
  fi
}

discover_with_fd() {
  local error_file status file
  local fd_args=(--show-errors --strip-cwd-prefix=never -t f -t l -e stest)

  if [[ $unrestricted == 1 ]]; then
    fd_args+=(-u)
  else
    fd_args+=(--exclude vendor --exclude node_modules)
  fi
  if [[ -n "$recent" ]]; then
    fd_args+=(--changed-within "$(recent_duration "$recent")")
  fi

  error_file=$(mktemp "${TMPDIR:-/tmp}/stest-all-fd.XXXXXX") || return 1
  fd "${fd_args[@]}" . 2> "$error_file" | while IFS= read -r file; do
    if [[ $executable_only != 1 || -x $file ]]; then
      printf '%s\n' "$file"
    fi
  done
  status=$?

  if [[ -s $error_file ]]; then
    cat "$error_file" >&2
    status=1
  fi
  rm -f "$error_file"
  return "$status"
}

discover_tests() {
  if command -v fd >/dev/null 2>&1; then
    discover_with_fd
  else
    discover_with_find
  fi
}

valid_tag() {
  [[ $1 =~ ^[[:alnum:]][[:alnum:]_.:-]*$ ]]
}

add_tag_tokens() {
  local definition=$1
  local source=$3
  local token
  local -a tokens
  local -n destination=$2

  definition=${definition//,/ }
  read -r -a tokens <<< "$definition"
  if [[ ${#tokens[@]} == 0 ]]; then
    echo "$source: tag list cannot be empty" >&2
    return 2
  fi
  for token in "${tokens[@]}"; do
    # special-use tags run-once(PERIOD) / fail-once(PERIOD): selected by name; stest checks the period
    [[ $token =~ ^(run-once|fail-once)(\(.*\))?$ ]] && token=${BASH_REMATCH[1]}
    if ! valid_tag "$token"; then
      echo "$source: invalid tag '$token'" >&2
      return 2
    fi
    # shellcheck disable=SC2034 # assignment writes through the destination nameref
    destination["$token"]=1
  done
}

parse_tag_selectors() {
  local definition token
  local -a tokens

  for definition in "${tag_filters[@]}"; do
    definition=${definition//,/ }
    read -r -a tokens <<< "$definition"
    if [[ ${#tokens[@]} == 0 ]]; then
      echo "--tag expects at least one tag" >&2
      return 2
    fi
    for token in "${tokens[@]}"; do
      if [[ $token == -* ]]; then
        token=${token#-}
        if ! valid_tag "$token"; then
          echo "--tag: invalid excluded tag '-$token'" >&2
          return 2
        fi
        excluded_tags["$token"]=1
      else
        if ! valid_tag "$token"; then
          echo "--tag: invalid tag '$token'" >&2
          return 2
        fi
        requested_tags["$token"]=1
      fi
    done
  done
}

# Read @tag / @require-tag declarations from the first four lines of a file
# into the normal and required associative arrays named by $2 and $3.
read_file_tags() {
  local file=$1
  local line directive definition read_status
  local line_number=0

  if ! exec 3< "$file"; then
    echo "Unable to read test file: $file" >&2
    return 2
  fi
  while (( line_number < 4 )); do
    line=
    IFS= read -r line <&3
    read_status=$?
    if [[ -z $line && $read_status != 0 ]]; then
      break
    fi
    ((line_number++))
    line=${line%$'\r'}
    if [[ $line =~ ^[[:space:]]*#[[:space:]]*@(tag|require-tag)([[:space:]]+(.*))?$ ]]; then
      directive=${BASH_REMATCH[1]}
      definition=${BASH_REMATCH[3]}
      if [[ $directive == tag ]]; then
        add_tag_tokens "$definition" "$2" "$file:$line_number" || {
          exec 3<&-
          return 2
        }
      else
        add_tag_tokens "$definition" "$3" "$file:$line_number" || {
          exec 3<&-
          return 2
        }
      fi
    fi
  done
  exec 3<&-
}

file_matches_tags() {
  local file=$1
  local token
  local required_match=0
  local positive_match=0
  local -A normal_tags=()
  local -A required_tags=()
  local -A file_tags=()

  read_file_tags "$file" normal_tags required_tags || return

  for token in "${!normal_tags[@]}" "${!required_tags[@]}"; do
    [[ -n $token ]] && file_tags["$token"]=1
  done

  for token in "${!excluded_tags[@]}"; do
    [[ ${file_tags[$token]+yes} ]] && return 1
  done

  # --all runs opt-in files as if their required tags were ordinary tags.
  if (( ${#required_tags[@]} > 0 && run_all == 0 )); then
    for token in "${!required_tags[@]}"; do
      if [[ ${requested_tags[$token]+yes} ]]; then
        required_match=1
        break
      fi
    done
    (( required_match == 1 )) || return 1
  fi

  if (( ${#requested_tags[@]} > 0 )); then
    for token in "${!requested_tags[@]}"; do
      if [[ ${file_tags[$token]+yes} ]]; then
        positive_match=1
        break
      fi
    done
    (( positive_match == 1 )) || return 1
  fi

  return 0
}

# Print "tag count" for every tag in the selected files, most used first.
# $1=required limits the report to @require-tag declarations.
count_tags() {
  local mode=$1
  local file token
  local -A normal_tags required_tags file_tags

  while IFS= read -r file; do
    normal_tags=()
    required_tags=()
    file_tags=()
    read_file_tags "$file" normal_tags required_tags || return
    if [[ $mode != required ]]; then
      for token in "${!normal_tags[@]}"; do
        file_tags["$token"]=1
      done
    fi
    for token in "${!required_tags[@]}"; do
      file_tags["$token"]=1
    done
    for token in "${!file_tags[@]}"; do
      printf '%s\n' "$token"
    done
  done | sort | uniq -c | sort -k1,1nr -k2,2 | awk '{ print $2, $1 }'
}

filter_tagged_tests() {
  local file status

  while IFS= read -r file; do
    file_matches_tags "$file"
    status=$?
    case $status in
      0) printf '%s\n' "$file" ;;
      1) ;;
      *) return "$status" ;;
    esac
  done
}

# --rerun-failed: the remembered failed files that still exist, in place of discovery
discover_failed() {
  local file
  php "$report_php" --print-failed --top="$PWD" | while IFS= read -r file; do
    [[ -f $file ]] || continue
    [[ $executable_only == 1 && ! -x $file ]] && continue
    printf '%s\n' "$file"
  done
}

discover_selected() {
  if [[ $rerun_failed == 1 ]]; then
    discover_failed
  else
    discover_tests
  fi
}

# warn about selector tags no discovered file declares (typos such as --tag=-lnog)
warn_unknown_tags() {
  local token known
  local -A known_tags=()
  (( ${#requested_tags[@]} + ${#excluded_tags[@]} > 0 )) || return 0
  while read -r token _; do
    [[ -n $token ]] && known_tags["$token"]=1
  done < <(discover_tests 2>/dev/null | count_tags all 2>/dev/null)
  known=$(printf '%s\n' "${!known_tags[@]}" | sort | head -20 | paste -sd ' ')
  for token in "${!requested_tags[@]}" "${!excluded_tags[@]}"; do
    if [[ ! ${known_tags[$token]+yes} ]]; then
      echo "stest-all: unknown tag '$token'; known tags: ${known:-none}" >&2
    fi
  done
}

list_tests() {
  local file mtime

  if [[ -n "$new" ]]; then
    discover_selected | filter_tagged_tests | while IFS= read -r file; do
      mtime=$(stat -c '%Y' "$file") || return
      printf '%s %s\n' "$mtime" "$file"
    done | sort -k1,1nr -k2,2 | sed -n "1,${new}p" | cut -d " " -f 2-
  else
    discover_selected | filter_tagged_tests
  fi
}

quiet=0
list=0
list_tags=
run_all=0
executable_only=0
unrestricted=0
recent=
new=
timeout=
timeout_set=0
jobs_opt=
jobs_set=0
jobs_source="-j/--jobs"
read_only=0
dir=
tag_filters=()
declare -A requested_tags=()
declare -A excluded_tags=()
stest_bin="$(cd "$(dirname "$0")" && pwd)/stest"
report_php="$(cd "$(dirname "$0")/../src" && pwd)/stest-all-report.php"
rerun_failed=0
retry=
retry_set=0
once=
shard=
slowest=
json=

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      exit 1
      ;;
    --list)
      list=1
      ;;
    -x|--executable)
      executable_only=1
      ;;
    --all)
      run_all=1
      ;;
    --list-tags)
      list_tags=all
      ;;
    --list-required)
      list_tags=required
      ;;
    -u|--unrestricted)
      unrestricted=1
      ;;
    --tag=*)
      tag_filters+=("${1#--tag=}")
      ;;
    --tag)
      echo "--tag requires a value, e.g. --tag='prod -long'" >&2
      exit 1
      ;;
    -q)
      quiet=1
      ;;
    --recent)
      recent=1day
      ;;
    --recent=*)
      recent="${1#--recent=}"
      ;;
    --new)
      new=1
      ;;
    --new=*)
      new="${1#--new=}"
      ;;
    --timeout=*)
      timeout="${1#--timeout=}"
      timeout_set=1
      ;;
    --timeout)
      echo "--timeout requires a value, e.g. --timeout=5" >&2
      exit 1
      ;;
    -j)
      if [[ $# -lt 2 ]]; then
        echo "-j requires a value, e.g. -j 40" >&2
        exit 1
      fi
      jobs_opt="$2"
      jobs_set=1
      shift
      ;;
    -j?*)
      jobs_opt="${1#-j}"
      jobs_set=1
      ;;
    --jobs=*)
      jobs_opt="${1#--jobs=}"
      jobs_set=1
      ;;
    --jobs)
      echo "--jobs requires a value, e.g. --jobs=40" >&2
      exit 1
      ;;
    -r|--read-only)
      read_only=1
      ;;
    --retry=*)
      retry="${1#--retry=}"
      retry_set=1
      ;;
    --retry)
      echo "--retry requires a value, e.g. --retry=2" >&2
      exit 1
      ;;
    --once)
      once=--once
      ;;
    --once=*)
      once="$1"
      ;;
    --rerun-failed)
      rerun_failed=1
      ;;
    --shard=*)
      shard="${1#--shard=}"
      ;;
    --shard)
      echo "--shard requires a value, e.g. --shard=1/4" >&2
      exit 1
      ;;
    --slowest)
      slowest=10
      ;;
    --slowest=*)
      slowest="${1#--slowest=}"
      ;;
    --json)
      json=-
      ;;
    --json=*)
      json="${1#--json=}"
      [[ -n $json ]] || { echo "--json= requires a file name" >&2; exit 1; }
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$dir" ]]; then
        echo "Unexpected argument: $1" >&2
        usage >&2
        exit 1
      fi
      dir="$1"
      ;;
  esac
  shift
done

parse_tag_selectors || exit $?

# Tag reports cover opt-in files too; otherwise --list-required would be empty.
[[ -n $list_tags ]] && run_all=1
# Remembered failures are an explicit list: an opt-in file that failed must run again.
[[ $rerun_failed == 1 ]] && run_all=1

if [[ $retry_set == 1 && ! "$retry" =~ ^([0-9]|10)$ ]]; then
  echo "--retry expects a number of extra attempts from 0 to 10, e.g. --retry=2" >&2
  exit 1
fi

shard_k=
shard_n=
if [[ -n "$shard" ]]; then
  if [[ ! "$shard" =~ ^([1-9][0-9]{0,5})/([1-9][0-9]{0,5})$ ]] || (( BASH_REMATCH[1] > BASH_REMATCH[2] )); then
    echo "--shard expects K/N with 1 <= K <= N, e.g. --shard=1/4" >&2
    exit 1
  fi
  shard_k=${BASH_REMATCH[1]}
  shard_n=${BASH_REMATCH[2]}
fi

if [[ -n "$slowest" && ! "$slowest" =~ ^[1-9][0-9]{0,5}$ ]]; then
  echo "--slowest expects a positive integer, e.g. --slowest=10" >&2
  exit 1
fi

if [[ -n "$once" && "$once" != --once ]] && ! [[ "${once#--once=}" =~ ^(reset|ignore|hourly|daily|weekly|[1-9][0-9]{0,6}[[:space:]]*(s|sec|m|min|h|hour|d|day|w|week|)s?)$ ]]; then
  echo "--once expects a period (1day, 12h, 30min, weekly, ...), reset, or ignore" >&2
  exit 1
fi

if [[ -n "$new" && ! "$new" =~ ^[1-9][0-9]*$ ]]; then
  echo "--new expects a positive integer" >&2
  exit 1
fi

if [[ -n "$recent" && ! "$recent" =~ ^[1-9][0-9]*(day|days)?$ ]]; then
  echo "--recent expects a positive number of days, e.g. --recent=2day" >&2
  exit 1
fi

if [[ $timeout_set == 1 && ! "$timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "--timeout expects a positive integer number of seconds, e.g. --timeout=5" >&2
  exit 1
fi

if [[ $jobs_set == 0 && -n ${STEST_JOBS:-} ]]; then
  jobs_opt=$STEST_JOBS
  jobs_set=1
  jobs_source=STEST_JOBS
fi

# At most 6 digits: longer values overflow bash arithmetic in parallel_jobs and
# would slip past the file-descriptor bound.
if [[ $jobs_set == 1 && ! "$jobs_opt" =~ ^[1-9][0-9]{0,5}$ ]]; then
  echo "$jobs_source expects a positive integer number of parallel jobs, e.g. -j 40" >&2
  exit 1
fi

if [[ -n "$dir" ]]; then
  cd "$dir" || exit 1
fi

test_list=$(mktemp "${TMPDIR:-/tmp}/stest-all.XXXXXX") || exit 1
work=$(mktemp -d "${TMPDIR:-/tmp}/stest-all-run.XXXXXX") || exit 1
trap 'rm -f "$test_list" "$test_list.shard"; rm -rf "$work"' EXIT

if [[ $rerun_failed == 1 && -z $(discover_failed) ]]; then
  [[ $quiet == 1 || $json == - ]] || echo "stest-all: no failed tests recorded for $PWD"
  [[ $json == - ]] && echo '{"ok": true, "summary": {"files": 0}, "files": []}'
  exit 0
fi

warn_unknown_tags
list_tests > "$test_list"
status=$?
if (( status != 0 )); then
  exit "$status"
fi

if (( ${#requested_tags[@]} > 0 && ${#excluded_tags[@]} == 0 )) && [[ ! -s $test_list ]]; then
  echo "No tests matched the requested tags" >&2
  exit 1
fi

# --shard=K/N: every N-th file of the final selection, starting with the K-th
if [[ -n $shard_n ]]; then
  awk -v k="$shard_k" -v n="$shard_n" '(NR - 1) % n == k - 1' "$test_list" > "$test_list.shard" &&
    mv "$test_list.shard" "$test_list" || exit 1
fi

if [[ -n $list_tags ]]; then
  count_tags "$list_tags" < "$test_list"
  exit $?
fi

if [[ $list == 1 ]]; then
  cat "$test_list"
  exit 0
fi

# check for GNU parallel
[[ $(type -P parallel) ]] || { echo "GNU parallel required"; exit 1; }
jobs=$(parallel_jobs "$jobs_opt") || { echo "Unable to determine parallel job limit" >&2; exit 1; }

# show errors only (in STDERR)
printf -v stest_command '%q {}' "$stest_bin"
[[ -n "$timeout" ]] && stest_command+=" --timeout=$timeout"
[[ $read_only == 1 ]] && stest_command+=" --read-only"
[[ -n "$once" ]] && stest_command+=" $(printf '%q' "$once")"
if [[ $quiet == 1 ]]; then
  stest_command+=" -q"
else
  stest_command+=" --color"
fi

# With -q and --retry, job output is held back so that a failure that passes on
# a later round never reaches cron; only each file's last attempt is printed.
hold=0
[[ $quiet == 1 && ${retry:-0} -gt 0 ]] && hold=1

# run_round N: run $work/N/list; N=0 is the main run
run_round() {
  local dir="$work/$1" command
  mkdir -p "$dir/out"
  printf -v command '%s --result-file=%q' "$stest_command" "$dir/results"
  if [[ $hold == 1 ]]; then
    printf -v command '%s >%q/{#}.1 2>%q/{#}.2' "$command" "$dir/out" "$dir/out"
    parallel -j "$jobs" --joblog "$dir/joblog" "$command" :::: "$dir/list"
  elif [[ $json == - ]]; then
    # STDOUT carries only the JSON document
    parallel -j "$jobs" --tag --joblog "$dir/joblog" "$command" :::: "$dir/list" >&2
  else
    parallel -j "$jobs" --tag --joblog "$dir/joblog" "$command" :::: "$dir/list"
  fi
}

# files of round N that failed (non-zero exit or signal), in list order
failed_of_round() {
  awk -F '\t' 'NR == FNR { file[FNR] = $0; next } FNR > 1 && ($7 != 0 || $8 != 0) { print file[$1] }' \
    "$work/$1/list" "$work/$1/joblog" | sort -u
}

# print held output: each file's last attempt, every line prefixed with its path
print_held() {
  local n file seq
  local -A last=()
  for (( n = 0; n <= rounds; n++ )); do
    seq=0
    while IFS= read -r file; do
      seq=$((seq + 1))
      last["$file"]="$n/out/$seq"
    done < "$work/$n/list"
  done
  while IFS= read -r file; do
    FILE=$file awk '{ print ENVIRON["FILE"] "\t" $0 }' "$work/${last[$file]}.1"
    FILE=$file awk '{ print ENVIRON["FILE"] "\t" $0 }' "$work/${last[$file]}.2" >&2
  done < "$work/0/list"
}

report_args=(--rounds="$work" --top="$PWD" --jobs="$jobs" --update-failed)
[[ $quiet == 1 ]] && report_args+=(--quiet)
[[ $quiet != 1 && -t 1 ]] && report_args+=(--color)
[[ -n "$slowest" ]] && report_args+=(--slowest="$slowest")
[[ -n "$json" ]] && report_args+=(--json="$json")

started=$EPOCHREALTIME
mkdir -p "$work/0" && cp "$test_list" "$work/0/list" || exit 1
run_round 0
status=$?
rounds=0
for (( n = 1; n <= ${retry:-0}; n++ )); do
  failed_of_round $((n - 1)) > "$work/retry.list"
  [[ -s $work/retry.list ]] || break
  if [[ $hold != 1 ]]; then
    if [[ $json == - ]]; then
      echo "--- stest-all: retry $n/$retry, $(wc -l < "$work/retry.list") failed files" >&2
    else
      echo "--- stest-all: retry $n/$retry, $(wc -l < "$work/retry.list") failed files"
    fi
  fi
  mkdir -p "$work/$n" && mv "$work/retry.list" "$work/$n/list" || exit 1
  run_round "$n"
  rounds=$n
done
[[ $hold == 1 ]] && print_held

php "$report_php" "${report_args[@]}" --started="$started"
report_status=$?
# GNU Parallel errors (exit > 101) win; otherwise the number of files still failing
(( status > 101 )) && exit "$status"
exit "$report_status"
